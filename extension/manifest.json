{
  "manifest_version": 3,
  "name": "Aside Sync",
  "version": "1.1.5",
  "description": "여러 PC의 Aside 채팅 기록, 메모리, 스킬, 설정을 클라우드 폴더로 동기화합니다.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms", "storage", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Aside Sync", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
